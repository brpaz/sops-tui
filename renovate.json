{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeMinor",
    ":prConcurrentLimit10",
    "security:gomodIndirectSecurityUpdates",
    "helpers:goXPackagesChangelogLink",
    "helpers:goXPackagesNameLink",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "reviewers": [
    "brpaz"
  ],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/build-docs\\.yml$/"],
      "matchStrings": ["pip install zensical==(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "zensical",
      "datasourceTemplate": "pypi"
    }
  ]
}
